+def _cpu_budget_parts(value):
+    if not isinstance(value, str):
+        return None
+    text = value.strip()
+    if re.fullmatch(r'-?[0-9]+[ \t]+-?[0-9]+', text) is None:
+        return None
+    try:
+        quota, period = map(int, text.split())
+    except ValueError:
+        return None
+    return quota, period
+
+def cpu_budget_matches(value, cpus):
+    """Whether numeric, positive cpu.max quota/period equals declared CPUs exactly."""
+    parts = _cpu_budget_parts(value)
+    if parts is None or isinstance(cpus, bool) or not isinstance(cpus, (int, float)):
+        return False
+    try:
+        declared = Fraction(str(cpus))
+    except (ValueError, ZeroDivisionError):
+        return False
+    quota, period = parts
+    return quota > 0 and period > 0 and declared > 0 and quota * declared.denominator == period * declared.numerator
+
