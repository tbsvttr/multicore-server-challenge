+    def pg_snapshot(self, directory, cdir, database, label):
+        self.docker('exec', '--user', 'root', self.target, 'python3', self.pg_collector,
+                    '--database', database, '--peer-postgres', '--out', cdir + '/pg-' + label + '.jsonl',
+                    '--once', '--max-seconds', '5', timeout=12,
+                    save=directory / ('pg-' + label + '.log'))
+        rows = [json.loads(line) for line in (directory / ('pg-' + label + '.jsonl')).read_text().splitlines() if line.strip()]
+        assert len(rows) == 1 and rows[0].get('ok') is True, 'observer snapshot failed'
+        observed = rows[0]['postgres']
+        assert observed.get('database') == database and str(observed.get('server_version_num', '')).startswith('18'), 'observer snapshot database/version mismatch'
+
+    def start_pg_collector(self, directory, cdir, database, max_seconds):
+        argv = ['docker', 'exec', '--user', 'root', self.target, 'setsid', '--wait', 'python3', self.pg_collector,
+                '--database', database, '--peer-postgres', '--out', cdir + '/pg-samples.jsonl',
+                '--stop', cdir + '/pg-collector.stop', '--interval', '1',
+                '--max-seconds', str(max_seconds)]
+        log = (directory / 'pg-collector.log').open('x')
+        proc = subprocess.Popen(argv, stdout=log, stderr=subprocess.STDOUT)
+        self.current_collectors.append((proc, log, directory, cdir))
+        write(directory / 'pg-collector-command.json', argv)
+        deadline = time.monotonic() + 8
+        while True:
+            output = directory / 'pg-samples.jsonl'
+            rows = output.read_text().splitlines() if output.exists() else []
+            if rows:
+                try:
+                    first = json.loads(rows[0])
+                except json.JSONDecodeError:
+                    first = None
+                if first is not None:
+                    assert first.get('ok') is True, 'first continuous PG observer sample failed'
+                    observed = first['postgres']
+                    assert observed.get('database') == database and str(observed.get('server_version_num', '')).startswith('18'), 'continuous PG observer database/version mismatch'
+                    write(directory / 'pg-collector-ready.json', {'ready': True, 'first_sample': first})
+                    return
+            if proc.poll() is not None or time.monotonic() >= deadline:
+                raise RuntimeError('continuous PG observer did not become ready before traffic')
+            time.sleep(.05)
+
+    def stop_pg_collectors(self):
+        workers, self.current_collectors = self.current_collectors, []
+        for proc, log, directory, cdir in workers:
+            (directory / 'pg-collector.stop').touch()
+            try:
+                rc = proc.wait(timeout=8)
+            except subprocess.TimeoutExpired:
+                # Only a collector with this exact frozen script/output pair may
+                # be signalled inside the shared target; never kill by name.
+                code = "import pathlib,os,signal;script=" + repr(self.pg_collector) + ";out=" + repr(cdir + '/pg-samples.jsonl') + ";matches=[]\nfor p in pathlib.Path('/proc').glob('[0-9]*/cmdline'):\n try:\n  a=p.read_bytes().split(bytes([0]));\n  if script.encode() in a and out.encode() in a: matches.append(int(p.parent.name))\n except OSError: pass\nfor pid in matches:\n if os.getpgid(pid)==pid: os.killpg(pid,signal.SIGTERM)\n else: os.kill(pid,signal.SIGTERM)\nprint(matches)"
+                with contextlib.suppress(Exception):
+                    self.docker('exec', '--user', 'root', self.target, 'python3', '-c', code, timeout=8,
+                                save=directory / 'pg-collector-stop.log')
+                try:
+                    rc = proc.wait(timeout=5)
+                except subprocess.TimeoutExpired:
+                    with contextlib.suppress(Exception):
+                        self.docker('exec', '--user', 'root', self.target, 'python3', '-c', code.replace('SIGTERM', 'SIGKILL'), timeout=8,
+                                    save=directory / 'pg-collector-kill.log')
+                    proc.kill(); proc.wait(timeout=3); rc = -9
+            finally:
+                log.close()
+            done = read(directory / 'pg-samples.jsonl.done.json', {})
+            write(directory / 'pg-collector-exit.json', {'exit': rc, 'diagnostic_only': True, 'completion_receipt': done, 'instrumentation_valid': rc == 0 and done.get('pass') is True})
+
+    def client_environment_witness(self, directory, run_id, count):
+        code = "import pathlib,os,json;binary=" + repr(self.cfg['native_binary']) + ";run=" + repr(run_id) + ";rows=[]\nfor p in pathlib.Path('/proc').glob('[0-9]*/cmdline'):\n try:\n  a=p.read_bytes().split(bytes([0]));\n  if os.path.realpath(p.parent/'exe')==binary and run.encode() in a:\n   env=dict(x.split(bytes([61]),1) for x in (p.parent/'environ').read_bytes().split(bytes([0])) if bytes([61]) in x);rows.append({'pid':int(p.parent.name),'env':{k:env.get(k.encode(),b'').decode() for k in ['GOMAXPROCS','GODEBUG']}})\n except OSError: pass\nprint(json.dumps(rows))"
+        # Native processes wait for the common start five seconds ahead; allow
+        # their Docker exec handshakes to complete before reading /proc.
+        deadline = time.monotonic() + 3
+        while True:
+            rows = json.loads(self.docker('exec', '--user', 'root', self.client, 'python3', '-c', code, timeout=5).stdout)
+            if len(rows) == count:
+                break
+            if time.monotonic() >= deadline:
+                raise RuntimeError('missing native process environment witnesses')
+            time.sleep(.1)
+        assert all(row['env'] == self.cfg['client_env'] for row in rows)
+        write(directory / 'client-env-witness.json', rows)
 
